#!/usr/bin/env python3
# GNU date 垫片：支持 -Is / +%s / -d "<openssl notAfter>" +%s
import sys, time, datetime
a = sys.argv[1:]
if a and a[0] == "-Is":
    print(datetime.datetime.now().astimezone().replace(microsecond=0).isoformat()); sys.exit(0)
if a and a[0] == "-d":
    s = a[1]
    dt = datetime.datetime.strptime(s.replace(" GMT", ""), "%b %d %H:%M:%S %Y")
    print(int(dt.replace(tzinfo=datetime.timezone.utc).timestamp())); sys.exit(0)
if a and a[0] == "+%s":
    print(int(time.time())); sys.exit(0)
print(int(time.time()))
