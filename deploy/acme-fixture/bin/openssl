#!/usr/bin/env python3
# openssl 垫片（夹具专用，确定性）：
#   req -new ... -keyout K -out C -addext subjectAltName=IP:x   → 造 K/C，C 里记下 SAN
#   req -in C -noout -text                                      → 打印 "IP Address:x"
#   x509 -in F -noout -enddate                                  → 按 F 同目录的 .hours 文件算到期
import sys, os, time, datetime
a = sys.argv[1:]
def val(flag):
    return a[a.index(flag)+1] if flag in a else None
if a[:1] == ["req"] and "-new" in a:
    san = ""
    for x in a:
        if x.startswith("subjectAltName="): san = x.split("=",1)[1]
    open(val("-keyout"), "w").write("FAKE-KEY\n")
    open(val("-out"), "w").write("FAKE-CSR san=%s\n" % san)
    sys.exit(0)
if a[:1] == ["req"] and "-in" in a and "-text" in a:
    s = open(val("-in")).read()
    san = s.split("san=")[1].strip() if "san=" in s else ""
    # 模仿 openssl -text 的输出形态（带空格，脚本会 tr -d ' '）
    print("        X509v3 Subject Alternative Name: ")
    print("            " + san.replace("IP:", "IP Address:"))
    sys.exit(0)
if a[:1] == ["x509"] and "-enddate" in a:
    f = val("-in")
    if not os.path.exists(f): sys.exit(1)
    hrs = 0.0
    hf = f + ".hours"
    if os.path.exists(hf): hrs = float(open(hf).read().strip())
    dt = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(hours=hrs)
    print("notAfter=" + dt.strftime("%b %d %H:%M:%S %Y") + " GMT")
    sys.exit(0)
sys.exit(1)
