[Unit]
Description=白帝控制中心 baidi-control
After=network.target

[Service]
Type=simple
User=@BD_USER@
WorkingDirectory=@BD_PREFIX@
Environment=BAIDI_ADDR=127.0.0.1:@CONTROL_PORT@
Environment=BAIDI_DB=@BD_PREFIX@/data/baidi.db
Environment=BAIDI_DOWNLOADS=@BD_PREFIX@/downloads
Environment=BAIDI_ENV=prod
# 公网来源（CORS）；同源经 nginx 反代时可留默认
Environment=BAIDI_CORS_ORIGIN=@PUBLIC_ORIGIN@
# 身份签名密钥：两把 Ed25519 按用途分签（首启自动生成 0600，公钥写同名 .pub）。
# knock 公钥是唯一分发给数据面的验证材料——网关拿不到会话密钥的公钥，
# 于是会话令牌在网关侧从密码学上就验不过。
Environment=BAIDI_JWT_KEY=@BD_PREFIX@/etc/keys/jwt-ed25519.pem
Environment=BAIDI_JWT_KNOCK_KEY=@BD_PREFIX@/etc/keys/jwt-ed25519-knock.pem
# 内部 CA（标准 X.509/P-256）：签发网关 mTLS 客户端证书
Environment=BAIDI_PKI_DIR=@BD_PREFIX@/etc/pki
# 网关接口的 mTLS 独立监听：/api/v1/gateways/* 只挂这里，明文口不再暴露该路由
Environment=BAIDI_MTLS_ADDR=127.0.0.1:@MTLS_PORT@
# control 专属保密配置（0600，仅本单元读；网关有自己的 env 文件）
EnvironmentFile=-@BD_PREFIX@/etc/baidi.env
ExecStart=@BD_PREFIX@/bin/baidi-control
Restart=on-failure
RestartSec=3
# 轻量加固
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=@BD_PREFIX@/data @BD_PREFIX@/etc

[Install]
WantedBy=multi-user.target
