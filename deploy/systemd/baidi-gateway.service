[Unit]
# 白帝数据面网关（可选）：SPA 单包授权 + 国密 TLCP 隧道代理。
# 注意：默认不开 -pf（内核态隐身用 nftables，该机 strongSwan-gm 也用 nft，需先评审 ruleset 再开，避免互相覆盖）。
# 启用前需在腾讯云安全组放行 18443/tcp + 18201/udp，并先跑一次 baidi-gmca 生成 @BD_PREFIX@/etc/gmcerts。
Description=白帝数据面网关 baidi-gateway
After=network.target

[Service]
Type=simple
User=@BD_USER@
WorkingDirectory=@BD_PREFIX@
# 网关专属配置：只含公钥与自己的 mTLS 证书路径，**不含任何签发能力**。
# （无 - 前缀：缺该文件即启动失败，绝不静默降级）
EnvironmentFile=@BD_PREFIX@/etc/baidi-gateway.env
# -gm 国密 TLCP；-certdir 持久化 CA 双证书；backend 为默认回退后端。
# 多资源路由：手动加 -resources @BD_PREFIX@/etc/resources.json（须先建该文件，否则网关启动报错）。
# -control 必须配：网关据此注册并周期拉策略——**强制下线/账号禁用/终端不合规的撤销名单
# 就是经这条通道下发的**，不配等于数据面永远收不到处置指令。走 mTLS 独立端口。
# 身份材料（客户端证书 + CA + 敲门公钥）由 baidi-control -issue-gateway-cert 离线签发。
ExecStart=@BD_PREFIX@/bin/baidi-gateway -gm -certdir @BD_PREFIX@/etc/gmcerts \
  -spa :18201 -proxy :18443 -backend 127.0.0.1:@CONTROL_PORT@ -ttl 30s \
  -control https://127.0.0.1:@MTLS_PORT@ -gwid @GW_ID@
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=@BD_PREFIX@/etc

[Install]
WantedBy=multi-user.target
