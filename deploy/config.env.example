# 复制为 config.env 并填写后用于 deploy.sh（config.env 已 gitignore）

# ── 场景 A：独占整机（推荐，101.43.125.131 铲除原业务后独占）──
SERVER_SSH=root@101.43.125.131
SSH_KEY=~/.ssh/id_ed25519
PUBLIC_HOST=101.43.125.131
BD_HTTPS_PORT=443            # 独占机用标准 443；安全组放行 443
WIPE=1                       # deploy.sh 部署前先铲除原业务（停服务+备份 nginx+释放 80/443）

# ── 场景 B：与烛龙共存（124.223.225.77）── 改用下面三行：
# SERVER_SSH=ubuntu@124.223.225.77
# SSH_KEY=~/.ssh/zhulong_tongsuo
# PUBLIC_HOST=124.223.225.77
# BD_HTTPS_PORT=9443         # 共存机用独立端口，绝不碰烛龙 80/443

# 安装前缀 / 运行用户 / 控制中心内部端口（回环）/ CORS 来源
BD_PREFIX=/opt/baidi
BD_USER=baidi
CONTROL_PORT=8090
# CORS 允许来源。默认 * = 任意网页可对控制面发跨源请求（含免认证的登录端点）。
# 生产建议改成逗号分隔白名单，需覆盖在用客户端的 webview 来源：
#   https://<控制台域名>,tauri://localhost,http://tauri.localhost,https://appassets.local
# ★改前逐平台实测——漏掉一个，该平台的客户端就连不上控制面。装机脚本会当面复述这段。
PUBLIC_ORIGIN=*

# ── 升级包发布公钥（BAIDI_UPGRADE_PUBKEY，可留空）──
# 控制面用它验「升级包描述文件（manifest）」的 Ed25519 签名（FR-UPG-04）。
#
# ★不配 = 升级包校验**恒为不通过**（fail-closed，是有意的：跳过验签等于任何人
#   都能推一个包上来）。不需要「上传升级包」这个功能时留空即可，页面会当面说明
#   为什么校验按钮是灰的；需要时按下面两步配：
#     1) 发布方（不在这台机器上）跑：control/cmd/baidi-upgrade -genkey
#     2) 把生成的 upgrade-sign.pub 的**内容**填在这里（轮换期可逗号分隔多把）
#   私钥留在发布方，绝不要放到运行控制面的机器上——控制面上没有任何东西能签出新包。
# BAIDI_UPGRADE_PUBKEY=

# ── 首登强制改密（**默认 1**，不填即启用）──
# BAIDI_SEED_MUST_CHANGE=1 时，control **首次建库**会把种子账号（含 admin）
# 全部置「首次登录须改密」：登录只发 15min 受限令牌，改掉公开的 baidi@123 才有会话。
# 仅首启建库时生效（库已存在再改无效）；deploy.sh 转发、install-remote.sh 写进
# $BD_PREFIX/etc/baidi.env 供 control 读取。
#
# ★只有**演示机**才置 0，而且必须显式写出来：种子口令 baidi@123 是公开的
# （README / CLAUDE.md / 演示站说明里都有），生产开局带着它等于没有口令。
# 置 0 是一次有意识的取舍，不该由一个谁也没看见的默认值替你做。
# BAIDI_SEED_MUST_CHANGE=0

# ── 数据面网关（WITH_GATEWAY=1 才装）──
# MTLS_PORT：网关接口的 mTLS 独立监听（回环）。/api/v1/gateways/* 只挂这里，
#            明文口不再暴露该路由；网关用客户端证书认身份，admin 令牌也调不到。
# GW_ID：本机网关 id，同时是 mTLS 客户端证书的 CN。多网关时每台一个。
MTLS_PORT=8092
GW_ID=gw-1

# ── 内核态隐身（WITH_STEALTH=1 才装，默认关）──
# 开启后：装 nftables 规则集（baidi-stealth.service，随网关起停、开机自动装）+ 网关以 root 带 -pf 运行。
# 效果：未经 SPA 授权的源 IP 发往 18443 的报文在内核被 DROP，扫描器看到 filtered 而非 open。
#
# ★这三项由这一个开关派生，**不要**手工去改服务单元或单独装规则集：
#   少任何一项都会落进一个比不开隐身更坏的状态——规则集装着而网关没带 -pf，
#   隧道口对所有人 DROP 而放行集合永远没人写，于是每个合法用户都连不上，
#   同时敲门成功、控制台显示网关在线、客户端只是拨号超时（各处都显示正常）。
#
# ★默认 0 的原因：本机可能跑着别的 nft 使用者（如 strongSwan-gm），两套 ruleset 需先评审。
# ★开启后云安全组要同时放行 18443/tcp 与 18201/udp：只放 UDP 的话敲门会成功而隧道连不上，
#   而那个组合的症状与"隐身生效"从外部看完全一样。
WITH_STEALTH=0

# ── 站点组网网关 baidi-ipsec（WITH_IPSEC=1 才装，默认关）──
# 自研 IKEv2 + ESP（用户态），走站点↔站点东西向；与南北向的 baidi-gateway 是两个进程。
# ★默认 0：它需要 CAP_NET_BIND_SERVICE + CAP_NET_ADMIN（绑 UDP 500、建 TUN 配路由），
#   而很多部署只要远程接入、不要站点组网，不该被迫背上一个要特权的组件。
WITH_IPSEC=0

# IPSEC_GW_ID：组网网关 id，同时是 mTLS 客户端证书 CN。不填默认 ipsec-${GW_ID}。
# ★必须以 ipsec- 开头：控制面按这个前缀分权——ipsec-* 只能调 /api/v1/gateways/ipsec*，
#   读不到全量资源授权策略（那是一张「谁能访问哪个后端」的完整地图）；反过来接入网关
#   的证书也取不到站点 PSK。写成 gw-1-ipsec（后缀形态）会被 403，安装脚本装机期就拦。
# ★★ 控制台上建站点时填的「所属网关」必须与这里**逐字符相同**：控制面按
#   gateway_id == 证书 CN 精确过滤下发站点清单。不一致时网关拉到的是**空列表而不是错误**——
#   站点会安静地永远 down、日志里一条协商记录都没有，看起来像「对端没配」。
#   这是 apps.resource_id 那类静默断链的翻版，排查最费时间。
IPSEC_GW_ID=ipsec-gw-1

# IKE_PORT / NATT_PORT：IKE 与 NAT-T(ESP-in-UDP) 的监听端口。
# ★保持默认 500/4500 时，两个都要在云安全组放行。只放 500 的症状最难查：
#   只要有一端在 NAT 后，IKE_AUTH 起就切 4500，全程被安全组吞掉——
#   站点停在「协商中」再无下文。
# ★该机若已跑 strongSwan，会抢同样这两个端口。install-remote.sh 有占用预检、检出即中止；
#   确需共存就改成高位端口（如 15500/15501），**对端配置与安全组规则必须同步改**。
IKE_PORT=500
NATT_PORT=4500
