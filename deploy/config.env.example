# 复制为 config.env 并填写后用于 deploy.sh（config.env 已 gitignore）

# ── 场景 A：独占整机（推荐，101.43.125.131 铲除原业务后独占）──
SERVER_SSH=root@101.43.125.131
SSH_KEY=~/.ssh/id_ed25519
PUBLIC_HOST=101.43.125.131
BD_HTTPS_PORT=443            # 独占机用标准 443；安全组放行 443
WIPE=1                       # deploy.sh 部署前先铲除原业务（停服务+备份 nginx+释放 80/443）

# ── 场景 B：与烛龙共存（124.223.225.77）── 改用下面三行：
# SERVER_SSH=ubuntu@124.223.225.77
# SSH_KEY=~/.ssh/zhulong_tongsuo
# PUBLIC_HOST=124.223.225.77
# BD_HTTPS_PORT=9443         # 共存机用独立端口，绝不碰烛龙 80/443

# 安装前缀 / 运行用户 / 控制中心内部端口（回环）/ CORS 来源
BD_PREFIX=/opt/baidi
BD_USER=baidi
CONTROL_PORT=8090
# CORS 允许来源。默认 * = 任意网页可对控制面发跨源请求（含免认证的登录端点）。
# 生产建议改成逗号分隔白名单，需覆盖在用客户端的 webview 来源：
#   https://<控制台域名>,tauri://localhost,http://tauri.localhost,https://appassets.local
# ★改前逐平台实测——漏掉一个，该平台的客户端就连不上控制面。装机脚本会当面复述这段。
PUBLIC_ORIGIN=*

# ── 升级包发布公钥（BAIDI_UPGRADE_PUBKEY，可留空）──
# 控制面用它验「升级包描述文件（manifest）」的 Ed25519 签名（FR-UPG-04）。
#
# ★不配 = 升级包校验**恒为不通过**（fail-closed，是有意的：跳过验签等于任何人
#   都能推一个包上来）。不需要「上传升级包」这个功能时留空即可，页面会当面说明
#   为什么校验按钮是灰的；需要时按下面两步配：
#     1) 发布方（不在这台机器上）跑：control/cmd/baidi-upgrade -genkey
#     2) 把生成的 upgrade-sign.pub 的**内容**填在这里（轮换期可逗号分隔多把）
#   私钥留在发布方，绝不要放到运行控制面的机器上——控制面上没有任何东西能签出新包。
# BAIDI_UPGRADE_PUBKEY=

# ── 首登强制改密（**默认 1**，不填即启用）──
# BAIDI_SEED_MUST_CHANGE=1 时，control **首次建库**会把种子账号（含 admin）
# 全部置「首次登录须改密」：登录只发 15min 受限令牌，改掉公开的 baidi@123 才有会话。
# 仅首启建库时生效（库已存在再改无效）；deploy.sh 转发、install-remote.sh 写进
# $BD_PREFIX/etc/baidi.env 供 control 读取。
#
# ★只有**演示机**才置 0，而且必须显式写出来：种子口令 baidi@123 是公开的
# （README / CLAUDE.md / 演示站说明里都有），生产开局带着它等于没有口令。
# 置 0 是一次有意识的取舍，不该由一个谁也没看见的默认值替你做。
# BAIDI_SEED_MUST_CHANGE=0

# ── 主机侧定期自动备份（NFR-AVL-04；四项由 deploy.sh 转发 → install-remote.sh 写进
#    $BD_PREFIX/etc/baidi.env → 控制面的 StartAutoBackupLoop 读）────────────────
#
# ★改造前这四项**一个都不在这份模板里**，也不在 deploy.sh 的转发白名单里：于是那个循环
#   在**每一台按脚本装出来的机器上都是关的**，而 /diag 那条 warn 的补救提示恰恰写着
#   「见 deploy/config.env.example」——照着提示翻过来，这里一个字都没有。
#
# ★为什么不能靠别的路顶替：`upgrade.CreateBackup` 只有两个非测试调用方——「管理员手点导出」
#   （产物直接 stream 给浏览器，服务器上一个字节都不落）与「温备节点来拉时现造」（要另有
#   一台机器）。单机部署（参考形态，也是演示站的形态）这两条一条都享受不到。
#
# ★口令**没有默认值、也不会有**：归档里装着内部 CA 私钥、三把 Ed25519 签名私钥、审计链
#   HMAC 密钥与全部凭据密文。编译进二进制或写在模板里的默认口令 = 没有加密。
#   **留空 = 不启用**（控制面打一行 WARN、/diag 判 warn 并说明原因，装机脚本也会当面告警），
#   不是「用一个内置口令凑合」。
#
# ★口令的两条硬约束（装机脚本会当场拒收不合规的值，不会让它静默改形）：
#   ① 至少 12 个字符（与控制面 upgrade.minPassphrase 同源，那边才是真执行方）；
#   ② 只能用 A-Z a-z 0-9 与 . _ - : @ + / = ~ ^ —— 它要经 systemd 的 EnvironmentFile 传给
#      控制面，而那个格式只是 shell 的一个子集，空白/引号/$/反引号/反斜杠/# 会被解析掉或
#      把值截断。被悄悄改形的口令是本功能最坏的失败形态：备份天天在做、也确实加密了，
#      只是用的不是你记下的那一串，直到恢复那天才发现全部归档打不开。
#   生成一个合规的强口令：openssl rand -base64 48 | tr -d '=+/' | cut -c1-40
#
# ★这里填了口令，它会经 ssh 命令行转发给装机脚本，于是**短暂出现在目标机的 `ps` 输出里**，
#   sudo 也可能把整条命令记进 auth.log。介意这一点的部署把本项留空，改成登上目标机手工往
#   $BD_PREFIX/etc/baidi.env 追加一行 BAIDI_BACKUP_PASSPHRASE=…（该文件 0600）再
#   `systemctl restart baidi-control`——装机脚本对**空值一个字节都不动**，重新部署不会抹掉它。
#   反过来的代价：**留空关不掉已经配好的自动备份**，要关得登机器删掉那一行再 restart。
#
# ★归档落在**被备份的这台机器上**：它挡的是「归档被拷到别处」（异地同步、误发），挡不住
#   「机器整台没了」。异地副本要么靠温备节点（见 README「控制面温备」），要么由运维把这个
#   目录同步出去——那时归档是加密的，正是这个口令的意义。
#   ★★口令丢了 = 全部历史归档永久解不开，请与备份**分开**保存。
# BAIDI_BACKUP_PASSPHRASE=

# 备份目录。留空、且填了口令、且这台机器上还没登记过目录时，取 $BD_PREFIX/backups
# （装机脚本按 0700 建好并 chown 给 BD_USER——控制面以 BD_USER 跑而 $BD_PREFIX 归 root，
#  不预先建好的话进程自己 MkdirAll 会 permission denied，功能停在「未启用」）。
# BAIDI_BACKUP_DIR=

# 间隔。★**裸数字按「秒」解释**（控制面 envDuration 的语义）：写 `24` 得到的是每 24 秒备份
# 一次，不是一天一次。必须带单位：24h / 12h / 30m。留空取默认 24h。
# BAIDI_BACKUP_INTERVAL=24h

# 保留份数（留空取默认 7）。清理按**文件名**排序删旧而不看 mtime——mtime 会被 rsync / 冷备
# 复制改写，按它删掉的可能正是最该留的那份。
# BAIDI_BACKUP_KEEP=7

# ── Let's Encrypt **IP 地址证书**（WITH_ACME_IP_CERT=1 才做，默认 0）──
#
# 开了之后：install-remote.sh 自造 CSR（CN 空、SAN=IP）→ lego 走 HTTP-01 签发 →
# nginx 指向 ${BD_PREFIX}/etc/tls/le.crt → 装续期脚本与 systemd 定时器（每日两次）。
# 关着（默认）时仍签自签证书、证书姿态一个字节不变。★但「渲染出来的 nginx 配置逐字一致」
# 只对共存机（BD_HTTPS_PORT≠443）成立：443 独占机上 80 端口那个 server 块多了一条恒定的
# ACME 挑战 location，且 return 301 挪进了 location /（原因见 nginx/baidi.conf 的注释——
# server 级的 return 在 rewrite 阶段执行、早于 location 选择，写在外面会把挑战一起重定向掉）。
# 行为等价（非挑战路径照旧 301），但别把它说成「零差异」。
#
# ★为什么是 IP 证书这么别扭的东西：大陆云主机上把一个**未备案**域名解析到本机，
#   ACME 的 HTTP-01 挑战会被 DNSPod 拦截——拿到的是一张 webblock 页面而不是挑战文件，
#   证书永远签不下来（sslip.io / nip.io 这类通配解析同样被拦，2026-09-08 演示站实测）。
#   而 IP 证书在挑战时 Host 就是 IP，不触发备案拦截，实测能正式签发。
#   **有真实域名（已备案 / 机器在境外）就别用这个开关**——常规域名证书 90 天有效期，
#   比这里两天一续的形态好得多。
#
# ★三条硬要求（缺一不可，install-remote.sh 会逐条当面拒绝并说明）：
#   ① PUBLIC_HOST 必须是裸 IPv4（证书的 SAN 就是它）；
#   ② BD_HTTPS_PORT 必须是 443（HTTP-01 要由本机 80 端口应答，而共存机的 80 归烛龙）；
#   ③ **公网能打到本机 80 端口**——云安全组要放行 80/tcp。只放 443 的话：今天一切正常，
#      六天后证书过期，中间没有任何告警。续期同样依赖它，不是只有首签要。
#
# ★有效期只有 6 天 15 小时（LE 对 IP 证书只给 shortlived profile），全靠
#   baidi-acme-renew.timer 续。定时器被停掉 = 六天后整站证书过期。
#   续不下来且剩余不足 24h 时，续期脚本会**主动切回自签**：退回浏览器警告，
#   好过证书过期（自签还能点「继续」，过期只会被读成站点整个挂了）。
#
# ★lego（ACME 客户端）由**构建机**交叉编译进部署包：目标机通常下不动 GitHub
#   （演示站实测 codeload.github.com 超时）。构建机也取不到该模块时 build.sh 只是
#   不携带它、不让整个构建失败，而 install-remote.sh 会在开关打开却没有 lego 时明确报错。
#   ★它有 ~65MB（几十家 DNS 服务商的 SDK 全静态链进去了），所以 **build.sh 只在这个开关
#     打开时才编译并携带它**（deploy.sh 把本开关一并传给构建步骤）。这与 baidi-ipsec /
#     baidi-standby「无条件带上」的取舍相反，理由只是体积：那两个各 3~6MB。
# WITH_ACME_IP_CERT=1
# ACME_EMAIL=ops@example.com        # LE 账户邮箱，开了上面那项就必填（到期提醒的唯一去处）
# ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory   # 默认值；排练可换 LE staging，
#                                   # 但 staging 签出来的证书**不受任何浏览器信任**，别拿它当"成功"

# ── 数据面网关（WITH_GATEWAY=1 才装，默认 0）──
# MTLS_PORT：网关接口的 mTLS 独立监听（回环）。/api/v1/gateways/* 只挂这里，
#            明文口不再暴露该路由；网关用客户端证书认身份，admin 令牌也调不到。
# GW_ID：本机网关 id，同时是 mTLS 客户端证书的 CN。**多网关时每台一个**——
#        两台填成同一个值时控制面会把它们当同一台：心跳互相覆盖、接入剖面里只有一个落点，
#        症状是「装了两台网关，控制台上只有一台」（不报错）。
# WITH_GATEWAY=1
MTLS_PORT=8092
GW_ID=gw-1

# ── 内核态隐身（WITH_STEALTH=1 才装，默认关）──
# 开启后：装 nftables 规则集（baidi-stealth.service，随网关起停、开机自动装）+ 网关以 root 带 -pf 运行。
# 效果：未经 SPA 授权的源 IP 发往 18443 的报文在内核被 DROP，扫描器看到 filtered 而非 open。
#
# ★这三项由这一个开关派生，**不要**手工去改服务单元或单独装规则集：
#   少任何一项都会落进一个比不开隐身更坏的状态——规则集装着而网关没带 -pf，
#   隧道口对所有人 DROP 而放行集合永远没人写，于是每个合法用户都连不上，
#   同时敲门成功、控制台显示网关在线、客户端只是拨号超时（各处都显示正常）。
#
# ★默认 0 的原因：本机可能跑着别的 nft 使用者（如 strongSwan-gm），两套 ruleset 需先评审。
# ★开启后云安全组要同时放行 18443/tcp 与 18201/udp：只放 UDP 的话敲门会成功而隧道连不上，
#   而那个组合的症状与"隐身生效"从外部看完全一样。
WITH_STEALTH=0

# ── 站点组网网关 baidi-ipsec（WITH_IPSEC=1 才装，默认关）──
# 自研 IKEv2 + ESP（用户态），走站点↔站点东西向；与南北向的 baidi-gateway 是两个进程。
# ★默认 0：它需要 CAP_NET_BIND_SERVICE + CAP_NET_ADMIN（绑 UDP 500、建 TUN 配路由），
#   而很多部署只要远程接入、不要站点组网，不该被迫背上一个要特权的组件。
WITH_IPSEC=0

# IPSEC_GW_ID：组网网关 id，同时是 mTLS 客户端证书 CN。不填默认 ipsec-${GW_ID}。
# ★必须以 ipsec- 开头：控制面按这个前缀分权——ipsec-* 只能调 /api/v1/gateways/ipsec*，
#   读不到全量资源授权策略（那是一张「谁能访问哪个后端」的完整地图）；反过来接入网关
#   的证书也取不到站点 PSK。写成 gw-1-ipsec（后缀形态）会被 403，安装脚本装机期就拦。
# ★★ 控制台上建站点时填的「所属网关」必须与这里**逐字符相同**：控制面按
#   gateway_id == 证书 CN 精确过滤下发站点清单。不一致时网关拉到的是**空列表而不是错误**——
#   站点会安静地永远 down、日志里一条协商记录都没有，看起来像「对端没配」。
#   这是 apps.resource_id 那类静默断链的翻版，排查最费时间。
IPSEC_GW_ID=ipsec-gw-1

# IKE_PORT / NATT_PORT：IKE 与 NAT-T(ESP-in-UDP) 的监听端口。
# ★保持默认 500/4500 时，两个都要在云安全组放行。只放 500 的症状最难查：
#   只要有一端在 NAT 后，IKE_AUTH 起就切 4500，全程被安全组吞掉——
#   站点停在「协商中」再无下文。
# ★该机若已跑 strongSwan，会抢同样这两个端口。install-remote.sh 有占用预检、检出即中止；
#   确需共存就改成高位端口（如 15500/15501），**对端配置与安全组规则必须同步改**。
IKE_PORT=500
NATT_PORT=4500
